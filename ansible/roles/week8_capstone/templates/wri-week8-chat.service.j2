[Unit]
Description=WRI CySec Week 8 Rocket.Chat lab portal
After=network.target

[Service]
User=appsvc
Group=appsvc
WorkingDirectory=/opt/wri-week8-chat
EnvironmentFile=/etc/wri-week8-chat.env
ExecStart=/usr/bin/python3 /opt/wri-week8-chat/app.py
Restart=on-failure
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
