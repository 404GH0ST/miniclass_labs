[Unit]
Description=WRI CySec intentionally vulnerable training application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/training-app
EnvironmentFile=/etc/wri-http-lab.env
ExecStart=/usr/bin/python3 /var/www/training-app/app.py
Restart=on-failure
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
