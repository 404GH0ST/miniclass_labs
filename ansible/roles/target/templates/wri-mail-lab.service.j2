[Unit]
Description=WRI CySec intentionally enumerable POP3 and IMAP lab
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nogroup
EnvironmentFile=/etc/wri-mail-lab.env
ExecStart=/usr/bin/python3 /opt/wri-mail-lab.py
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
